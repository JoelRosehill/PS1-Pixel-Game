    "assets:validate": "node tools/assets-manifest.mjs",
    "assettest": "node tools/assettest.mjs",
    "spelltest": "node tools/spelltest.mjs",
    "kinetictest": "node tools/kinetictest.mjs",
    "enemytest": "node tools/enemytest.mjs",
    "worldtest": "node tools/worldtest.mjs",
    "atlastest": "node tools/atlastest.mjs",
    "bosstest": "node tools/bosstest.mjs",
    "savetest": "node tools/savetest.mjs",
    "uitest": "node tools/uitest.mjs",
    "buildtest": "node tools/buildtest.mjs",
    "perf": "node tools/perf.mjs"
